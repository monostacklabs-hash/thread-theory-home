{
  "name": "thread-theory-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync-insta": "node scripts/sync-insta.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:cf": "node --env-file=.env.production node_modules/vite/bin/vite.js build",
    "preview:cf": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cf": "npm run build:cf && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.4",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "firebase": "^11.6.0",
    "jose": "^6.2.17",
    "next": "^15.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "firebase-admin": "^13.1.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react-server-dom-webpack": "^19.3.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.3",
    "vinext": "^1.4.5",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "type": "module"
}
